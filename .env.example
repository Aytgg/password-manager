# Frontend (Vite)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=

# Rust (build.rs tarafından derleme anında binary'ye gömülür)
# PEM satır sonları "\n" olarak yazılabilir.
CLERK_JWKS_PUBLIC_KEY=
CLERK_ISSUER=
# Virgülle ayrılmış izinli origin'ler (geliştirme + yayın), örn:
# http://localhost:5173,tauri://localhost,http://tauri.localhost
CLERK_AUTHORIZED_PARTIES=
